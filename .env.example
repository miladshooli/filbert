# Copy to .env and edit. Every setting in filbert.config.Settings can be set as FILBERT_<NAME>.

# Required for a server reachable from outside: one or more keys, comma-separated.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
FILBERT_API_KEYS=

# uvicorn processes (each one has its own HTTP client, cache handle and extraction thread)
FILBERT_SERVE_WORKERS=2

# Fetching
FILBERT_RESPECT_ROBOTS=true
FILBERT_RENDER=never              # never | auto | always (auto/always need the render image)
FILBERT_PER_HOST_CONCURRENCY=4
FILBERT_MAX_BODY_BYTES=20000000

# API limits
FILBERT_API_MAX_BATCH=20
FILBERT_API_MAX_JOB_URLS=5000
FILBERT_API_MAX_RUNNING_JOBS=2
FILBERT_API_ALLOW_PRIVATE_URLS=false   # true only on a private network you trust
FILBERT_API_CORS_ORIGINS=              # e.g. https://panel.example.com

# Push every page of every job to your panel (HMAC-SHA256 signed when a secret is set)
FILBERT_WEBHOOK_URL=
FILBERT_WEBHOOK_SECRET=

# Optional Claude layer (/v1/llm); costs are billed to this key
FILBERT_API_LLM=false
ANTHROPIC_API_KEY=
